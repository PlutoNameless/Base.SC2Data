<?xml version="1.0" encoding="UTF-8"?>
<Catalog>

    <CButton id="TaldarimGateway">
        <Icon value="Assets\Textures\btn-unit-protoss-alarak-taldarim-gateway.dds"/>
    </CButton>

    <CUnit id="TaldarimGateway" parent="Generic_Protoss_Structure" race="Tald">
        <Mob value="Campaign"/>
        <LifeStart value="500"/>
        <LifeMax value="500"/>
        <ShieldsStart value="500"/>
        <ShieldsMax value="500"/>
        <Radius value="1.75"/>
        <SeparationRadius value="1.75"/>
        <Footprint value="Footprint3x3Contour"/>
        <PlacementFootprint value="Footprint3x3"/>
        <ScoreMake value="150"/>
        <ScoreKill value="150"/>
        <SubgroupPriority value="2"/>
        <MinimapRadius value="1.75"/>
        <BuildTime value="65"/>
        <EditorCategories value="ObjectType:Structure,ObjectFamily:Melee"/>
        <AbilArray Link="que5"/>
        <AbilArray Link="GatewayTrain"/>
        <AbilArray Link="Rally"/>
        <AbilArray Link="UpgradeToWarpGate"/>
        <CardLayouts index="0">
            <LayoutButtons Face="Cancel" Type="AbilCmd" AbilCmd="que5,CancelLast" Row="2" Column="4"/>
            <LayoutButtons Face="Cancel" Type="AbilCmd" AbilCmd="UpgradeToWarpGate,Cancel" Row="2" Column="4"/>
            <LayoutButtons Face="Rally" Type="AbilCmd" AbilCmd="Rally,Rally1" Row="1" Column="4"/>
            <LayoutButtons Face="UpgradeToWarpGate" Type="AbilCmd" AbilCmd="UpgradeToWarpGate,Execute" Row="2" Column="0"/>
        </CardLayouts>
        <GlossaryPriority value="22"/>
        <CostResource index="Minerals" value="150"/>
        <TechTreeProducedUnitArray value="WarpGate"/>
        <TechTreeProducedUnitArray value="Supplicant"/>
        <TechTreeProducedUnitArray value="Havoc"/>
        <TechTreeProducedUnitArray value="Slayer"/>
        <TechTreeProducedUnitArray value="Ascendant"/>
        <TechTreeProducedUnitArray value="BloodHunter"/>
    </CUnit>

    <CActorUnit id="TaldarimGateway" parent="ProtossCollection@Building" unitName="TaldarimGateway">
        <On Terms="UnitConstruction.*.Start" Send="Create TaldarimProbe_Build@BuildMedium"/>
        <Aliases value="_UnitHuge"/>
        <Macros value="QueueAnim"/>
        <Macros value="GlobalLoopMacro"/>
        <Macros value="GlobalLoopMacroMore"/>
        <On Terms="ActorCreation" Send="AnimGroupRemove Superior"/>
        <!-- Morph data -->
        <On Terms="BehaviorLevel.PowerUserQueue.Start; Level 0" Send="AnimSetPaused Morph"/>
        <On Terms="BehaviorLevel.PowerUserQueue.Stop; Level 0" Send="AnimSetPaused Morph 0"/>
        <On Terms="AbilMorph.*.Start; MorphFrom Gateway; MorphTo WarpGate" Send="Destroy"/>
        <On Terms="AbilMorph.*.Start; MorphFrom WarpGate; MorphTo Gateway" Send="Create"/>
        <On Terms="AbilMorph.*.Start; MorphFrom WarpGate; MorphTo Gateway" Send="AnimPlay Morph Morph,End 0 0.000000"/>
        <On Terms="AbilMorph.*.Finish; MorphFrom WarpGate; MorphTo Gateway" Send="AnimClear Morph"/>
        <ModelFlags index="AutomateGlobalLoops" value="0"/>
        <CreepHeightClass value="Small"/>
        <BarOffset value="140"/>
        <BarWidth value="160"/>
        <GroupIcon>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway.dds"/>
        </GroupIcon>
        <NameOffset value="130"/>
        <UnitFlags index="ShowBlobShadow" value="0"/>
        <Wireframe>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway.dds"/>
        </Wireframe>
        <WireframeShield>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield01.dds"/>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield02.dds"/>
            <Image value="Assets\Textures\Wireframe-Protoss-Gateway-Shield03.dds"/>
        </WireframeShield>
    </CActorUnit>

    <CModel id="TaldarimGateway" parent="BuildingEx">
        <Model value="Assets\Buildings\Protoss\Gateway_Taldarim_Collection\Gateway_Taldarim_Collection.m3"/>
        <ScaleMax value="0.800000,0.800000,0.800000"/>
        <ScaleMin value="0.800000,0.800000,0.800000"/>
        <SelectionRadius value="2.500000"/>
        <SquibTypeDefault value="Metal"/>
        <Radius value="2.000000"/>
        <ShadowRadius value="2.500000"/>
        <Events Anim="Morph" Name="MorphStart" Type="Sound" Payload="TaldarimGateway@MorphToWarpgate"/>
        <Events Anim="Morph,End" Name="MorphEnd" Type="Sound" Payload="TaldarimGateway@MorphToGateway"/>
    </CModel>
    <CModel id="TaldarimGateway@Death" parent="BuildingDeathEx">
        <Model value="Assets\Buildings\Protoss\Gateway_Taldarim_Death\Gateway_Taldarim_Death.m3"/>
    </CModel>
    <CModel id="TaldarimGateway@Placement" parent="PlacementEx">
        <Model value="Assets/Buildings/Protoss/Gateway_Taldarim_Placement/Gateway_Taldarim_Placement.m3"/>
        <ScaleMax value="0.800000,0.800000,0.800000"/>
        <ScaleMin value="0.800000,0.800000,0.800000"/>
    </CModel>
    <CModel id="TaldarimGateway@Splat" parent="Splat">
        <Model value="Assets\Splats\Splat_Gateway\Splat_Gateway.m3"/>
        <EditorCategories value="Race:Protoss"/>
        <ScaleMax value="0.800000,0.800000,0.800000"/>
        <ScaleMin value="0.800000,0.800000,0.800000"/>
    </CModel>
    <CModel id="TaldarimGateway@Birth" parent="TaldarimGateway">
        <Model value="Assets\Buildings\Protoss\Gateway_Taldarim_WarpIn\Gateway_Taldarim_WarpIn.m3"/>
        <Events>
            <Anim value="Stand,Build,End"/>
            <Name value="BuildingWarpIn"/>
            <Type value="Sound"/>
            <Time value="1.333300"/>
        </Events>
    </CModel>
    <CModel id="TaldarimGateway@Portrait" parent="ExecutorPortrait"/>
    <CModel id="TaldarimGateway@DeathUnderConstruction" parent="ProtossBuildingBuildDeath"/>

    <CSound id="TaldarimGateway@Explode" parent="Protoss_ExplosionLarge"/>
    <CSound id="TaldarimGateway@What" parent="Voice">
        <AssetArray File="Assets\Sounds\Protoss\Gateway\Gateway_What.ogg"/>
        <EditorCategories value="Race:Protoss"/>
        <Volume value="-4.500000,-4.500000"/>
    </CSound>
    <CSound id="TaldarimGateway@Ready" parent="Ready">
        <AssetArray File="Assets\Sounds\Protoss\Gateway\Gateway_What.ogg"/>
        <EditorCategories value="Race:Protoss"/>
        <Volume value="-4.500000,-4.500000"/>
    </CSound>
    <CSound id="TaldarimGateway@MorphToWarpgate" parent="Build">
        <EditorCategories value="Race:Protoss"/>
        <AssetArray File="Assets\Sounds\Protoss\Gateway\Gateway_MorphToWarpGate0.wav"/>
        <AssetArray File="Assets\Sounds\Protoss\Gateway\Gateway_MorphToWarpGate1.wav"/>
        <DupeDestroyCount value="3"/>
        <Volume value="-3.000000,-3.000000"/>
    </CSound>
    <CSound id="TaldarimGateway@MorphToGateway" parent="Build">
        <EditorCategories value="Race:Protoss"/>
        <AssetArray File="Assets\Sounds\Protoss\WarpGate\WarpGate_MorphToGateway0.wav"/>
        <AssetArray File="Assets\Sounds\Protoss\WarpGate\WarpGate_MorphToGateway1.wav"/>
        <AssetArray File="Assets\Sounds\Protoss\WarpGate\WarpGate_MorphToGateway2.wav"/>
        <Volume value="-3.000000,-3.000000"/>
    </CSound>

</Catalog>